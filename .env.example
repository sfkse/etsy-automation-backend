# ─── AI Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FAL_API_KEY=your_fal_api_key_here

# ─── Video (Higgsfield image-to-video) ───────────────────────────────────────
# Create server-side keys at https://cloud.higgsfield.ai
HIGGSFIELD_API_KEY_ID=your_higgsfield_api_key_id_here
HIGGSFIELD_API_KEY_SECRET=your_higgsfield_api_key_secret_here

# ─── Etsy ─────────────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
ETSY_SHOP_ID=your_etsy_shop_id_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Host-side value, used when you run alembic/pytest/uvicorn outside Docker.
# The `api` container overrides the host to `postgres` automatically, so leave
# this pointing at localhost even when running via docker compose.
DATABASE_URL=postgresql+psycopg://etsy:etsy_local_dev@localhost:5432/etsy_taki

# ─── Storage ──────────────────────────────────────────────────────────────────
IMAGES_DIR=./data/images

# Public origin of this app (no trailing slash). Required for video generation:
# Higgsfield fetches the source photo by URL and cannot reach localhost.
# Use a tunnel (e.g. ngrok) in dev, or the deployed domain in prod.
PUBLIC_BASE_URL=https://your-public-host.example

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# One of: gemini | openai | flux
DEFAULT_IMAGE_WORKFLOW=gemini
# Video model: dop (fixed ~5s, best quality) | kling (5s or 10s)
DEFAULT_VIDEO_WORKFLOW=dop
