# ─── AI Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FAL_API_KEY=your_fal_api_key_here

# ─── Etsy ─────────────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
ETSY_SHOP_ID=your_etsy_shop_id_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Default matches docker-compose.yml; override only if running postgres elsewhere
DATABASE_URL=postgresql+psycopg://etsy:etsy_local_dev@localhost:5432/etsy_taki

# ─── Storage ──────────────────────────────────────────────────────────────────
IMAGES_DIR=./data/images

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# One of: gemini | openai | flux
DEFAULT_IMAGE_WORKFLOW=gemini
